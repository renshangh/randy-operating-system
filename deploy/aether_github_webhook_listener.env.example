# MacBook-side Aether GitHub webhook listener example environment
# Parent issue: #199
# Child issue: #201

# Required
GITHUB_WEBHOOK_SECRET=replace_me

# Listener bind
LISTENER_HOST=127.0.0.1
LISTENER_PORT=8787

# Repo allowlist
ALLOWED_REPOS=renshangh/randy-operating-system,renshangh/randy-job-hunt-pipeline,renshangh/marketing-ops,renshangh/knowledge-base

# Optional repo path overrides
ORCHESTRATION_RANDY_OPERATING_SYSTEM_PATH=$HOME/repo/randy-operating-system
ORCHESTRATION_KNOWLEDGE_BASE_PATH=$HOME/repo/knowledge-base
ORCHESTRATION_MARKETING_OPS_PATH=$HOME/repo/marketing-ops
ORCHESTRATION_RANDY_JOB_HUNT_PIPELINE_PATH=$HOME/repo/randy-job-hunt-pipeline

# Optional direct Aether wake
ENABLE_DIRECT_SESSION_WAKE=0
AETHER_SESSION_LABEL=aether-ops-inbox
AETHER_SESSION_ID=
AETHER_SESSION_REGISTRY=$HOME/.openclaw/workspace/aether_session_registry.json
SESSION_SEND_TIMEOUT_SECONDS=60
SESSION_ACK_TIMEOUT_SECONDS=120

# Optional Discord wake-up mirror
# Used for the production wake path when a valid specialist return is detected.
DISCORD_HEARTBEAT_WEBHOOK_URL=
DISCORD_AETHER_USER_ID=

# Logging path is handled by the launcher or service wrapper.
